# Optional AI analysis provider. Leave blank to build with Pending AI fields.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional arXiv pipeline overrides.
ARXIV_INIT_CANDIDATES=400
ARXIV_DAILY_CANDIDATES=40
ARXIV_PER_QUERY_LIMIT=50
ARXIV_DELAY_SECONDS=3
ARXIV_MAX_RETRIES=3
ARXIV_USER_AGENT=EmbodiedResearchRadar/0.1 (contact: your-email@example.com)
